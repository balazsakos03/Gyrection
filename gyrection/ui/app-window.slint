import { VerticalBox, HorizontalBox, Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Gyrection";
    preferred-width: 1000px;
    preferred-height: 650px;
    min-width: 860px;
    min-height: 560px;
    background: #111315;

    // --- State properties (set from Rust) ---
    in property <bool> is-connected: false;
    in property <string> connection-status-text: "No device connected";
    in property <string> steering-val: "0%";
    in property <string> throttle-val: "0%";
    in property <string> brake-val: "0%";
    in property <bool> handbrake-active: false;
    in property <string> pitch-val: "0.00°";
    in property <string> yaw-val: "0.00°";
    // Quaternion values are parsed on the Rust side and kept there for debugging.
    // If needed later, re-enable these properties and the related UI section below.
    // in property <string> qw-val: "0.000";
    // in property <string> qx-val: "0.000";
    // in property <string> qy-val: "0.000";
    // in property <string> qz-val: "1.000";
    in property <string> server-status-text: "WiFi UDP";
    // True when the Xbox 360 virtual controller is live on the ViGEmBus
    in property <bool> virtual-controller-active: false;
    // ------------------------------------------------

    callback connect-clicked();

    VerticalBox {
        padding: 22px;
        spacing: 14px;

        // Header
        HorizontalBox {
            height: 54px;

            VerticalBox {
                spacing: 2px;

                Text {
                    text: "Gyrection";
                    color: #f1f3f5;
                    font-size: 24px;
                    font-weight: 700;
                }

                Text {
                    text: "Phone motion controller";
                    color: #858b94;
                    font-size: 13px;
                }
            }

            Text {
                text: root.is-connected ? "●  CONNECTED" : "●  DISCONNECTED";
                color: root.is-connected ? #4CAF50 : #858b94;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // Connection + virtual controller (compact row, height follows content)
        HorizontalBox {
            spacing: 14px;

            // Phone connection
            Rectangle {
                background: #1b1e22;
                border-radius: 12px;
                border-width: 1px;
                border-color: #2b3037;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: "PHONE CONNECTION";
                        color: #858b94;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    Text {
                        text: root.connection-status-text;
                        color: #f1f3f5;
                        font-size: 18px;
                        font-weight: 600;
                    }

                    Text {
                        text: root.is-connected ? "Receiving sensor data..." : "Phone auto-connects over WiFi.";
                        color: #858b94;
                        font-size: 13px;
                    }

                    Button {
                        text: root.is-connected ? "Connected" : "Connect device";
                        primary: true;
                        enabled: !root.is-connected;

                        clicked => {
                            connect-clicked();
                        }
                    }
                }
            }

            // Virtual controller
            Rectangle {
                background: #1b1e22;
                border-radius: 12px;
                border-width: 1px;
                border-color: #2b3037;

                VerticalBox {
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: "VIRTUAL CONTROLLER";
                        color: #858b94;
                        font-size: 11px;
                        font-weight: 700;
                    }

                    Text {
                        text: root.virtual-controller-active ? "Emulated" : "Not emulated";
                        color: root.virtual-controller-active ? #4CAF50 : #f1f3f5;
                        font-size: 18px;
                        font-weight: 600;
                    }

                    Text {
                        text: root.virtual-controller-active
                            ? "Xbox 360 controller active via ViGEmBus."
                            : "Install the ViGEmBus driver, then restart.";
                        color: #858b94;
                        font-size: 13px;
                    }
                }
            }
        }

        // Live data (this section stretches with the window size)
        Rectangle {
            background: #1b1e22;
            border-radius: 12px;
            border-width: 1px;
            border-color: #2b3037;

            VerticalBox {
                padding: 18px;
                spacing: 14px;

                Text {
                    text: "LIVE SENSOR DATA";
                    color: #858b94;
                    font-size: 12px;
                    font-weight: 700;
                }

                HorizontalBox {
                    spacing: 14px;

                    // Orientation (pitch / yaw)
                    Rectangle {
                        background: #15181b;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 16px;
                            spacing: 8px;

                            Text {
                                text: "ORIENTATION";
                                color: #aeb4bd;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            Text {
                                text: "Pitch";
                                color: #626872;
                                font-size: 13px;
                            }

                            Text {
                                text: root.pitch-val;
                                color: #e8eaed;
                                font-size: 18px;
                                font-weight: 600;
                            }

                            Text {
                                text: "Yaw";
                                color: #626872;
                                font-size: 13px;
                            }

                            Text {
                                text: root.yaw-val;
                                color: #e8eaed;
                                font-size: 18px;
                                font-weight: 600;
                            }
                        }
                    }

                    // Controller output (steering / throttle / brake / handbrake)
                    Rectangle {
                        background: #15181b;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 16px;
                            spacing: 8px;

                            Text {
                                text: "CONTROLLER";
                                color: #aeb4bd;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            HorizontalBox {
                                Text {
                                    text: "Steering";
                                    color: #626872;
                                    font-size: 13px;
                                    width: 120px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.steering-val;
                                    color: #e8eaed;
                                    font-size: 18px;
                                    font-weight: 600;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalBox {
                                Text {
                                    text: "Throttle";
                                    color: #626872;
                                    font-size: 13px;
                                    width: 120px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.throttle-val;
                                    color: #e8eaed;
                                    font-size: 18px;
                                    font-weight: 600;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalBox {
                                Text {
                                    text: "Brake";
                                    color: #626872;
                                    font-size: 13px;
                                    width: 120px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: root.brake-val;
                                    color: #e8eaed;
                                    font-size: 18px;
                                    font-weight: 600;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }

                            // Handbrake feedback on the PC
                            Rectangle {
                                height: 8px;
                                border-radius: 4px;
                                background: root.handbrake-active ? #F44336 : #2b3037;
                            }

                            Text {
                                text: root.handbrake-active ? "HANDBRAKE ACTIVE" : "HANDBRAKE";
                                color: root.handbrake-active ? #F44336 : #626872;
                                font-size: 13px;
                                font-weight: 700;
                            }
                        }
                    }

                    // --- Quaternion debug section (disabled) ---
                    // Rectangle {
                    //     background: #15181b;
                    //     border-radius: 8px;
                    //
                    //     VerticalBox {
                    //         padding: 16px;
                    //         spacing: 8px;
                    //
                    //         Text {
                    //             text: "QUATERNION";
                    //             color: #aeb4bd;
                    //             font-size: 13px;
                    //             font-weight: 600;
                    //         }
                    //
                    //         Text { text: "W     " + root.qw-val; color: #e8eaed; font-size: 14px; }
                    //         Text { text: "X     " + root.qx-val; color: #e8eaed; font-size: 14px; }
                    //         Text { text: "Y     " + root.qy-val; color: #e8eaed; font-size: 14px; }
                    //         Text { text: "Z     " + root.qz-val; color: #e8eaed; font-size: 14px; }
                    //     }
                    // }
                    // -------------------------------------------------
                }
            }
        }

        // Footer
        HorizontalBox {
            height: 30px;

            Text {
                text: root.server-status-text;
                color: #626872;
                font-size: 12px;
                vertical-alignment: center;
            }

            Text {
                text: "Gyrection v0.1.0";
                color: #626872;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

