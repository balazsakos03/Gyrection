import { VerticalBox, HorizontalBox, Button } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Gyrection";
    width: 1000px;
    height: 650px;
    background: #111315;

    // --- ÚJ PROPERTIEK (Ezeket állítja a Rust kód) ---
    in property <bool> is-connected: false;
    in property <string> connection-status-text: "No device connected";
    in property <string> steering-val: "0%";
    in property <string> throttle-val: "0%";
    in property <string> pitch-val: "0.00°";
    in property <string> yaw-val: "0.00°";
    in property <string> qw-val: "0.000";
    in property <string> qx-val: "0.000";
    in property <string> qy-val: "0.000";
    in property <string> qz-val: "1.000";
    // ------------------------------------------------

    callback connect-clicked();

    VerticalBox {
        padding: 28px;
        spacing: 24px;

        // Header
        HorizontalBox {
            height: 58px;

            VerticalBox {
                spacing: 2px;

                Text {
                    text: "Gyrection";
                    color: #f1f3f5;
                    font-size: 26px;
                    font-weight: 700;
                }

                Text {
                    text: "Phone motion controller";
                    color: #858b94;
                    font-size: 14px;
                }
            }

            Text {
                // Dinamikus státusz a jobb felső sarokban
                text: root.is-connected ? "●  CONNECTED" : "●  DISCONNECTED";
                color: root.is-connected ? #4CAF50 : #858b94;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // Connection + controller
        HorizontalBox {
            spacing: 18px;
            height: 235px;

            // Phone connection
            Rectangle {
                background: #1b1e22;
                border-radius: 12px;
                border-width: 1px;
                border-color: #2b3037;

                VerticalBox {
                    padding: 24px;
                    spacing: 12px;

                    Text {
                        text: "PHONE CONNECTION";
                        color: #858b94;
                        font-size: 12px;
                        font-weight: 700;
                    }

                    Text {
                        text: root.connection-status-text;
                        color: #f1f3f5;
                        font-size: 21px;
                        font-weight: 600;
                    }

                    Text {
                        text: root.is-connected ? "Receiving sensor data..." : "Connect your Android phone via USB.";
                        color: #858b94;
                        font-size: 14px;
                    }

                    Rectangle {
                        height: 1px;
                        background: #2b3037;
                    }

                    Button {
                        text: root.is-connected ? "Connected" : "Connect device";
                        primary: true;
                        enabled: !root.is-connected;

                        clicked => {
                            connect-clicked();
                        }
                    }
                }
            }

            // Virtual controller
            Rectangle {
                background: #1b1e22;
                border-radius: 12px;
                border-width: 1px;
                border-color: #2b3037;

                VerticalBox {
                    padding: 24px;
                    spacing: 12px;

                    Text {
                        text: "VIRTUAL CONTROLLER";
                        color: #858b94;
                        font-size: 12px;
                        font-weight: 700;
                    }

                    Text {
                        text: root.is-connected ? "Active" : "Inactive";
                        color: root.is-connected ? #4CAF50 : #f1f3f5;
                        font-size: 21px;
                        font-weight: 600;
                    }

                    Text {
                        text: root.is-connected ? "Mapping motion to virtual gamepad." : "A virtual gamepad will appear here.";
                        color: #858b94;
                        font-size: 14px;
                    }

                    Rectangle {
                        height: 1px;
                        background: #2b3037;
                    }

                    Text {
                        text: root.is-connected ? "Controller running smoothly." : "Waiting for phone connection...";
                        color: #626872;
                        font-size: 13px;
                    }
                }
            }
        }

        // Live data
        Rectangle {
            background: #1b1e22;
            border-radius: 12px;
            border-width: 1px;
            border-color: #2b3037;

            VerticalBox {
                padding: 22px;
                spacing: 16px;

                Text {
                    text: "LIVE SENSOR DATA";
                    color: #858b94;
                    font-size: 12px;
                    font-weight: 700;
                }

                HorizontalBox {
                    spacing: 16px;

                    // Quaternion
                    Rectangle {
                        background: #15181b;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 16px;
                            spacing: 8px;

                            Text {
                                text: "QUATERNION";
                                color: #aeb4bd;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            Text {
                                text: "W     " + root.qw-val;
                                color: #e8eaed;
                                font-size: 14px;
                            }

                            Text {
                                text: "X     " + root.qx-val;
                                color: #e8eaed;
                                font-size: 14px;
                            }

                            Text {
                                text: "Y     " + root.qy-val;
                                color: #e8eaed;
                                font-size: 14px;
                            }

                            Text {
                                text: "Z     " + root.qz-val;
                                color: #e8eaed;
                                font-size: 14px;
                            }
                        }
                    }

                    // Orientation
                    Rectangle {
                        background: #15181b;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 16px;
                            spacing: 8px;

                            Text {
                                text: "ORIENTATION";
                                color: #aeb4bd;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            Text {
                                text: "Pitch";
                                color: #626872;
                                font-size: 13px;
                            }

                            Text {
                                text: root.pitch-val;
                                color: #e8eaed;
                                font-size: 20px;
                                font-weight: 600;
                            }

                            Text {
                                text: "Yaw";
                                color: #626872;
                                font-size: 13px;
                            }

                            Text {
                                text: root.yaw-val;
                                color: #e8eaed;
                                font-size: 20px;
                                font-weight: 600;
                            }
                        }
                    }

                    // Controller values
                    Rectangle {
                        background: #15181b;
                        border-radius: 8px;

                        VerticalBox {
                            padding: 16px;
                            spacing: 8px;

                            Text {
                                text: "CONTROLLER";
                                color: #aeb4bd;
                                font-size: 13px;
                                font-weight: 600;
                            }

                            Text {
                                text: "Steering";
                                color: #626872;
                                font-size: 13px;
                            }

                            Text {
                                text: root.steering-val;
                                color: #e8eaed;
                                font-size: 20px;
                                font-weight: 600;
                            }

                            Text {
                                text: "Throttle";
                                color: #626872;
                                font-size: 13px;
                            }

                            Text {
                                text: root.throttle-val;
                                color: #e8eaed;
                                font-size: 20px;
                                font-weight: 600;
                            }
                        }
                    }
                }
            }
        }

        // Footer
        HorizontalBox {
            height: 36px;

            Text {
                text: "USB connection (ADB Reverse)";
                color: #626872;
                font-size: 12px;
                vertical-alignment: center;
            }

            Text {
                text: "Gyrection v0.1.0";
                color: #626872;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}